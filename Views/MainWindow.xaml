<Window x:Class="MeteoForecast.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeteoForecast.ViewModels"
        xmlns:views="clr-namespace:MeteoForecast.Views"
        xmlns:converters="clr-namespace:MeteoForecast.Converters"
        Title="MeteoForecast">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
                <converters:AlertColorConverter x:Key="AlertColorConverter"/>
                <converters:SettingsActiveBackgroundConverter x:Key="SettingsActiveBackgroundConverter"/>
                <converters:FavouriteIconConverter x:Key="FavouriteIconConverter"/>
                <converters:WeatherIconConverter x:Key="WeatherIconConverter"/>

                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                        <views:MainView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                        <views:SearchView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:CityWeatherViewModel}">
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                </DataTemplate>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#22000000"
                        Padding="12,8">
                        <TextBox Text="{Binding SearchViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="SearchBox_PreviewTextInput"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 PreviewMouseDown="SearchBox_PreviewMouseDown"
                                 Background="#F0F0F0"
                                 BorderThickness="0"
                                 Padding="10,6"
                                 FontSize="17">
                                <TextBox.InputBindings>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding SearchViewModel.SearchCommand}"/>
                                </TextBox.InputBindings>
                        </TextBox>
                </Border>

                <!-- Active view -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentViewModel}"/>

                <!-- Bottom bar -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#22000000"
                        Padding="12,6">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Alert button -->
                                <Button Grid.Column="0"
                                        Command="{Binding ToggleAlertsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠"
                                                           FontSize="23"
                                                           Foreground="{Binding AlertsViewModel.HasActiveAlerts,
                                       Converter={StaticResource AlertColorConverter}}"/>
                                                <!-- <Border Background="#CC333333"
                                                        CornerRadius="8"
                                                        Padding="4,1"
                                                        Margin="4,0,0,0"
                                                        Visibility="{Binding .HasActiveAlerts,
                                    Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding AlertsViewModel.ActiveAlertsCount}"
                                                                   Foreground="White"
                                                                   FontSize="14"/>
                                                </Border> -->
                                        </StackPanel>
                                </Button>

                                <!-- Settings button -->
                                <Border Grid.Column="2"
                                        CornerRadius="4"
                                        Padding="4"
                                        Background="{Binding IsSettingsActive,
                            Converter={StaticResource SettingsActiveBackgroundConverter}}">
                                        <Button Command="{Binding GoToSettingsCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                                <TextBlock Text="⚙"
                                                           FontSize="23"/>
                                        </Button>
                                </Border>
                        </Grid>
                </Border>

                <!-- Alert panel as overlay -->
                <!-- <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,40"
                        MaxHeight="300"
                        Background="White"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="8,8,0,0"
                        Visibility="{Binding IsAlertsOpen,
                    Converter={StaticResource BoolToVis}}">
                        <views:AlertsView DataContext="{Binding AlertsViewModel}"/> 
                </Border>-->
        </Grid>
</Window>