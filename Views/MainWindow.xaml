<Window x:Class="MeteoForecast.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MeteoForecast.ViewModels"
        xmlns:views="clr-namespace:MeteoForecast.Views"
        Title="MeteoForecast">

        <Window.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVis"/>

                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                        <views:MainView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                        <views:SearchView/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type vm:CityWeatherViewModel}">
                        <views:CityWeatherView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:CityWeatherView/>
                </DataTemplate>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="#22000000"
                        Padding="12,8">
                        <Button Command="{Binding GoToSearchCommand}"
                                Background="#F0F0F0"
                                BorderThickness="0"
                                HorizontalContentAlignment="Left"
                                Padding="10,6"
                                Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="Szukaj miasta..."
                                                   Foreground="Gray"/>
                                </StackPanel>
                        </Button>
                </Border>

                <!-- Active view -->
                <ContentControl Grid.Row="1"
                                Content="{Binding CurrentViewModel}"/>

                <!-- Bottom bar -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#22000000"
                        Padding="12,6">
                        <Grid>
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Alert button -->
                                <Button Grid.Column="0"
                                        Command="{Binding ToggleAlertsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠"
                                                           FontSize="18"
                                                           Foreground="{Binding AlertsViewModel.HasActiveAlerts,
                                       Converter={StaticResource AlertColorConverter}}"/>
                                                <Border Background="#CC333333"
                                                        CornerRadius="8"
                                                        Padding="4,1"
                                                        Margin="4,0,0,0"
                                                        Visibility="{Binding AlertsViewModel.HasActiveAlerts,
                                    Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding AlertsViewModel.ActiveAlertsCount}"
                                                                   Foreground="White"
                                                                   FontSize="11"/>
                                                </Border>
                                        </StackPanel>
                                </Button>

                                <!-- Settings button -->
                                <Border Grid.Column="2"
                                        CornerRadius="4"
                                        Padding="4"
                                        Background="{Binding IsSettingsActive,
                            Converter={StaticResource SettingsActiveBackgroundConverter}}">
                                        <Button Command="{Binding GoToSettingsCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand">
                                                <TextBlock Text="⚙"
                                                           FontSize="18"/>
                                        </Button>
                                </Border>
                        </Grid>
                </Border>

                <!-- Alert panel as overlay -->
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,40"
                        MaxHeight="300"
                        Background="White"
                        BorderThickness="1"
                        BorderBrush="#22000000"
                        CornerRadius="8,8,0,0"
                        Visibility="{Binding IsAlertsOpen,
                    Converter={StaticResource BoolToVis}}">
                        <views:AlertsView DataContext="{Binding AlertsViewModel}"/>
                </Border>
        </Grid>

</Window>