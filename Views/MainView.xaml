<UserControl x:Class="MeteoForecast.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MeteoForecast.Models">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Ulubione"
                   FontSize="13"
                   Foreground="Gray"
                   Margin="0,0,0,8"/>

        <!-- Favourites grid -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Favourites}"
                      Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:City}">
                    <Border Margin="0,0,8,0"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            CornerRadius="8"
                            Padding="12,10"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.SelectedCityCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Name and heart symbol -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Medium"
                                           FontSize="13"/>
                                <Button HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ToggleFavouriteCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding IsFavourite,
                                                   Converter={StaticResource FavouriteIconConverter}}"/>
                                </Button>
                            </Grid>

                            <!-- Country -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Country}"
                                       FontSize="11"
                                       Foreground="Gray"
                                       Margin="0,2,0,0"/>

                            <!-- Temperature from CityWeatherViewModel -->
                            <TextBlock Grid.Row="2"
                                       FontSize="18"
                                       FontWeight="Medium"
                                       Margin="0,6,0,0"
                                       Text="{Binding DataContext.CurrentTemperature,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Hourly data -->
        <Border Grid.Row="2"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header, day navigation -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedCity.Name,
                                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   FontSize="15"
                                   FontWeight="Medium"/>
                        <TextBlock Text="{Binding SelectedDay, StringFormat='{}{0:ddd d MMM}'}"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Content="◀"
                                Command="{Binding PreviousDayCommand}"
                                Background="Transparent"
                                BorderThickness="1"
                                Padding="6,2"
                                Margin="0,0,4,0"/>
                        <Button Content="▶"
                                Command="{Binding NextDayCommand}"
                                Background="Transparent"
                                BorderThickness="1"
                                Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- Hours -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Forecast}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HourlyWeather}">
                                <Border Margin="0,0,6,0"
                                        Background="#F5F5F5"
                                        CornerRadius="6"
                                        Padding="8,6"
                                        MinWidth="60">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DateTime, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="11"
                                                   Foreground="Gray"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding WeatherCode,
                                                       Converter={StaticResource WeatherIconConverter}}"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F0}°'}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Precipitation, StringFormat='{}{0:F1}mm'}"
                                                   FontSize="10"
                                                   Foreground="#378ADD"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>



