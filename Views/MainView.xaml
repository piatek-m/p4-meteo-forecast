<UserControl x:Class="MeteoForecast.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MeteoForecast.ViewModels"
             xmlns:models="clr-namespace:MeteoForecast.Models"
             xmlns:converters="clr-namespace:MeteoForecast.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:FavouriteIconConverter x:Key="FavouriteIconConverter"/>
        <converters:WeatherIconConverter x:Key="WeatherIconConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Ulubione"
                   FontSize="17"
                   Foreground="SteelBlue"
                   Margin="0,0,0,8"/>

        <!-- Favourites grid -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Favourites}"
                      Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FavouriteCityViewModel}">
                    <Border Margin="0,0,8,0"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            CornerRadius="8"
                            Padding="12,10"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.SelectCityCommand, 
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding City}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Name and heart symbol -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding City.Name}"
                                           FontWeight="Medium"
                                           FontSize="16"/>
                                <Button HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ToggleFavouritesCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding City}">
                                    <TextBlock Text="{Binding City.IsFavourite,
                                            Converter={StaticResource FavouriteIconConverter}}"/>
                                </Button>
                            </Grid>

                            <!-- Country -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding City.Country}"
                                       FontSize="16"
                                       Foreground="Gray"
                                       Margin="0,2,0,0"/>

                            <!-- Temperature -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="0,6,0,0">
                                <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F0}°'}"
                                           FontSize="21"
                                           FontWeight="Medium"/>
                                <TextBlock Text="{Binding WeatherCode, 
                   Converter={StaticResource WeatherIconConverter}}"
                                           FontSize="23"
                                           Margin="6,0,0,0"/>
                            </StackPanel>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Hourly data -->
        <Border Grid.Row="2"
                DataContext="{Binding CityWeather}"
                Visibility="{Binding SelectedCity, Converter={StaticResource NullToVisibilityConverter}}"
                BorderThickness="1"
                BorderBrush="#22000000"
                CornerRadius="8"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header, day navigation -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,12">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding SelectedCity.Name}"
                                   FontSize="21"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding DayLabel}"
                                   FontSize="16"
                                   Foreground="SteelBlue"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Content="◀"
                                Command="{Binding PreviousDayCommand}"
                                Background="Transparent"
                                BorderThickness="1"
                                Padding="6,2"
                                Margin="0,0,4,0"/>
                        <Button Content="▶"
                                Command="{Binding NextDayCommand}"
                                Background="Transparent"
                                BorderThickness="1"
                                Padding="6,2"/>
                    </StackPanel>
                </Grid>

                <!-- Hours -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding ForecastDisplay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0"
                                        Background="#F5F5F5"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        MinWidth="80">
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- Particular hour/time -->
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm}'}"
                                                   FontSize="19"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"/>
                                        <!-- Weather code icon -->
                                        <TextBlock Text="{Binding WeatherCode,
                                               Converter={StaticResource WeatherIconConverter}}"
                                                   FontSize="36"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,6"/>
                                        <!-- Temperature -->
                                        <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F0}'}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <!-- Feels like -->
                                        <TextBlock Text="{Binding FeelsLike, StringFormat='{}odcz. {0:F0}'}"
                                                   FontSize="18"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <!-- Separator-->
                                        <Border Height="1"
                                                Background="#22000000"
                                                Margin="0,6,0,6"/>
                                        <!-- Precipitation -->
                                        <TextBlock Text="{Binding Precipitation}"
                                                   FontSize="18"
                                                   Foreground="#378ADD"
                                                   HorizontalAlignment="Center"
                                                   Visibility="{Binding PrecipitationRaw,
                                                   Converter={StaticResource GreaterThanZeroConverter}}"/>
                                        <!-- Snowfall -->
                                        <TextBlock Text="{Binding Snowfall}"
                                                   FontSize="18"
                                                   Foreground="#88AADD"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding SnowfallRaw,
                                                   Converter={StaticResource GreaterThanZeroConverter}}"/>
                                        <!-- Pressure -->
                                        <TextBlock Text="{Binding Pressure, StringFormat='{}{0:F0}'}"
                                                   FontSize="18"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <!-- Wind speed -->
                                        <TextBlock Text="{Binding WindSpeed, StringFormat='{}{0:F1}'}"
                                                   FontSize="18"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <!-- Wind direction -->
                                        <TextBlock Text="{Binding WindDirection}"
                                                   FontSize="18"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                        <!-- Humidity-->
                                        <TextBlock Text="{Binding Humidity, StringFormat='{}{0}'}"
                                                   FontSize="18"
                                                   Foreground="Black"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>



